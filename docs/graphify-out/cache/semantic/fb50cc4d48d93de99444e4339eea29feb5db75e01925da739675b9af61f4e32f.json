{"nodes": [{"id": "docs_confluence_trade_filtration_whitepaper_confluence_trade_filtration_system", "label": "Confluence-Based Trade Filtration System", "file_type": "paper", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces rigid all-or-nothing parameter matching with a weighted scorecard so multi-asset universes can be screened for high-probability entries while suppressing low-quality setups."}, {"id": "docs_confluence_trade_filtration_whitepaper_weighted_scorecard_architecture", "label": "Weighted Scorecard Architecture", "file_type": "rationale", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each candidate is scored across seven confluence categories with importance weights reflecting historical reliability as probability drivers, then tiered for position sizing."}, {"id": "docs_confluence_trade_filtration_whitepaper_gatekeepers", "label": "Gatekeeper Filters (Stage 1)", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binary pass/fail conditions reject a setup before any scoring runs if any one gate fails."}, {"id": "docs_confluence_trade_filtration_whitepaper_minimum_risk_reward", "label": "Minimum Risk:Reward Gate", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projected R:R must be \u2265 1:2; below that the setup is rejected regardless of confluence score."}, {"id": "docs_confluence_trade_filtration_whitepaper_htf_directional_bias", "label": "HTF Directional Bias Gate", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTF trend must resolve exclusively Bullish or Bearish; Ranging HTF disqualifies the setup with no scoring applied."}, {"id": "docs_confluence_trade_filtration_whitepaper_session_kill_zone_timing", "label": "Session / Kill-Zone Timing Gate", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entry must fall inside the asset's active liquidity window; setups outside kill zones are down-weighted or rejected."}, {"id": "docs_confluence_trade_filtration_whitepaper_confluence_scorecard", "label": "Confluence Scorecard (100 pts)", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_multi_timeframe_alignment", "label": "Multi-Timeframe Alignment", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_market_structure_shift_displacement", "label": "Market Structure Shift + Displacement", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sharp displacement leaving an unmitigated FVG or inverse FVG confirms institutional intent rather than a slow drift."}, {"id": "docs_confluence_trade_filtration_whitepaper_order_flow_microstructure", "label": "Order Flow / Microstructure", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_volatility_expansion_confirmation", "label": "Volatility Expansion Confirmation", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_premium_discount_positioning", "label": "Premium/Discount Positioning", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entry should be in discount (longs) or premium (shorts) of the HTF dealing range, not chasing an extended move."}, {"id": "docs_confluence_trade_filtration_whitepaper_macro_intermarket_correlation", "label": "Macro / Intermarket Correlation", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_asset_class_specific_layer", "label": "Asset-Class Specific Layer", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Category 7 filters are not interchangeable; apply only the layer matching the asset being screened."}, {"id": "docs_confluence_trade_filtration_whitepaper_fair_value_gap", "label": "Fair Value Gap (FVG)", "file_type": "concept", "source_file": "Confluence_Trade_Filtration_Whitepaper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_confluence_trade_filtration_whitepaper_smt_divergence", "label": "SMT Dive